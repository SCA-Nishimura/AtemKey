<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- BMDSwitcherAPI uses built-in COM interop -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated with TlbImp from ATEM Switchers' BMDSwitcherAPI64.dll -->
    <Reference Include="Interop.BMDSwitcherAPI">
      <HintPath>lib\Interop.BMDSwitcherAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Generate the interop assembly on first build (not committed: derived from Blackmagic's SDK) -->
  <Target Name="GenerateBmdInterop" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('lib\Interop.BMDSwitcherAPI.dll')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\generate-interop.ps1&quot;" />
  </Target>

</Project>
